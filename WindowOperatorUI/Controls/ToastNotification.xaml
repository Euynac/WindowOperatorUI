<Window x:Class="WindowOperatorUI.Controls.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Notification" 
        SizeToContent="WidthAndHeight"
        MinWidth="300"
        MaxWidth="450"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    
    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
        
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>
    
    <Border CornerRadius="8" Background="#2D2D2D" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="Black" ShadowDepth="3" Opacity="0.4"/>
        </Border.Effect>
        
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Icon -->
            <TextBlock x:Name="IconTextBlock" Text="&#xE7BA;" 
                       FontFamily="Segoe MDL2 Assets" 
                       FontSize="24" 
                       Foreground="#4CAF50"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
            
            <!-- Message -->
            <TextBlock x:Name="MessageTextBlock" Grid.Column="1"
                       Text="Notification message" 
                       Foreground="White"
                       TextWrapping="Wrap"
                       FontSize="14"
                       VerticalAlignment="Center"/>
            
            <!-- Close button -->
            <Button Grid.Column="2" Content="✕" 
                    Background="Transparent"
                    Foreground="#999999"
                    BorderThickness="0"
                    Click="CloseButton_Click"
                    Padding="8"
                    Margin="10,0,0,0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window> 