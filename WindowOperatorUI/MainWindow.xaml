<Window x:Class="WindowOperatorUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowOperatorUI"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Window Operator" Height="650" Width="900"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">
    
    <Window.Resources>
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" 
                                       FontFamily="Segoe MDL2 Assets" 
                                       FontSize="12"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <Style x:Key="ConfigCheckboxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NumberTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="PathTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="#CC222222" BorderBrush="#44FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="315" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="#33000000" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Window Operator" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnMinimize" Content="&#xE921;" Style="{StaticResource WindowButtonStyle}" Click="BtnMinimize_Click"/>
                    <Button x:Name="btnClose" Content="&#xE8BB;" Style="{StaticResource WindowButtonStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Settings -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Application Settings" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <CheckBox Grid.Row="0" Grid.Column="0" x:Name="chkSilentMode" Content="Silent Mode" 
                                 Foreground="#FFFFFF" Margin="0,0,0,5" Checked="AppSettings_Changed" Unchecked="AppSettings_Changed"/>
                        
                        <CheckBox Grid.Row="1" Grid.Column="0" x:Name="chkRunAtStartup" Content="Run at Startup" 
                                 Foreground="#FFFFFF" Margin="0,0,0,5" Checked="AppSettings_Changed" Unchecked="AppSettings_Changed"/>
                        
                        <CheckBox Grid.Row="2" Grid.Column="0" x:Name="chkRunAsAdmin" Content="Run as Administrator" 
                                 Foreground="#FFFFFF" Margin="0,0,0,5" Checked="AppSettings_Changed" Unchecked="AppSettings_Changed"/>
                        
                        <CheckBox Grid.Row="3" Grid.Column="0" x:Name="chkKeepOriginalSize" Content="Keep Original Window Size" 
                                 Foreground="#FFFFFF" Margin="0,0,0,5" Checked="AppSettings_Changed" Unchecked="AppSettings_Changed"/>
                    </Grid>
                </StackPanel>

                <!-- Window Configurations -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Window Configurations" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="btnAddConfig" Content="Add New" Click="BtnAddConfig_Click" 
                                Padding="8,3" Background="#3377FF" Foreground="White" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                    
                    <ListView Grid.Row="1" x:Name="lvWindowConfigs" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="LvWindowConfigs_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="#33000000"/>
                                <Setter Property="Margin" Value="0,0,0,5"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="5">
                                                <Grid>
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                                                      Margin="{TemplateBinding Padding}"/>
                                                    <Border x:Name="SelectedBorder" BorderThickness="1" BorderBrush="#3377FF" CornerRadius="5" Visibility="Collapsed"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#44555555"/>
                                                    <Setter TargetName="SelectedBorder" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#44444444"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <CheckBox Grid.Column="0" x:Name="chkSelectConfig" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        
                                        <TextBlock Grid.Column="1" Text="{Binding ExePath, StringFormat='Path: {0}'}" 
                                                   Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                        
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button x:Name="btnSelectWindow" Content="&#xEE57;" Click="BtnSelectWindow_Click" Tag="{Binding}"
                                                    FontFamily="Segoe MDL2 Assets" Padding="5" Margin="0,0,5,0" ToolTip="Select Window">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="3"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                            <Button x:Name="btnEditPath" Content="✏" Click="BtnEditPath_Click" Tag="{Binding}"
                                                    Padding="5" Margin="0,0,5,0" ToolTip="Edit Path">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="3"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                            <Button x:Name="btnRunConfig" Content="▶" Click="BtnRunConfig_Click" Tag="{Binding}" 
                                                    Padding="5" Margin="0,0,5,0" ToolTip="Run">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="3"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                            <Button x:Name="btnRemoveConfig" Content="✕" Click="BtnRemoveConfig_Click" Tag="{Binding}"
                                                    Padding="5" Background="#E53935" Foreground="White" BorderThickness="0" ToolTip="Remove">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="3"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- Path Edit Row (Initially Hidden) -->
                                    <Grid Grid.Row="1" x:Name="pathEditGrid" Visibility="Collapsed" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="txtExePath" Text="{Binding ExePath}" 
                                                Padding="5" Margin="0,0,5,0"/>
                                        <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseExePath_Click" Tag="{Binding}"
                                                Padding="5,0" Background="#3377FF" Foreground="White" BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="3"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                    
                                    <Grid Grid.Row="2" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,15,0">
                                            <TextBlock Text="X:" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding X}" Style="{StaticResource NumberTextBoxStyle}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,15,0">
                                            <TextBlock Text="Y:" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Y}" Style="{StaticResource NumberTextBoxStyle}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,15,0">
                                            <TextBlock Text="Width:" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Width}" Style="{StaticResource NumberTextBoxStyle}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <TextBlock Text="Height:" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Height}" Style="{StaticResource NumberTextBoxStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <Grid Grid.Row="3" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <CheckBox Grid.Column="0" Content="Always on Top" IsChecked="{Binding EnableAlwaysOnTop}" 
                                                 Foreground="#FFFFFF" Margin="0,0,15,0"/>
                                        
                                        <CheckBox Grid.Column="1" Content="Topmost" IsChecked="{Binding EnableAlwaysOnTopMost}" 
                                                 Foreground="#FFFFFF" Margin="0,0,15,0"/>
                                        
                                        <CheckBox Grid.Column="2" Content="Mouse Through" IsChecked="{Binding EnableMouseThrough}" 
                                                 Foreground="#FFFFFF"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Action Buttons -->
                <Grid Grid.Row="2" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="1" x:Name="btnRunSelected" Content="Run Selected" Click="BtnRunSelected_Click" 
                            Padding="12,6" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    
                    <Button Grid.Column="2" x:Name="btnSaveConfig" Content="Save Configuration" Click="BtnSaveConfig_Click" 
                            Padding="12,6" Background="#3377FF" Foreground="White" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
