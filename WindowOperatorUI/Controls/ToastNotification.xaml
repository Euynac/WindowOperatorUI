<Window x:Class="WindowOperatorUI.Controls.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Notification" 
        SizeToContent="WidthAndHeight"
        MinWidth="300"
        MaxWidth="450"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    
    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
        
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>
    
    <Border CornerRadius="6" Background="#333333" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Color="Black" ShadowDepth="1" Opacity="0.3"/>
        </Border.Effect>
        
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Icon -->
            <TextBlock x:Name="IconTextBlock" Text="&#xE7BA;" 
                       FontFamily="Segoe MDL2 Assets" 
                       FontSize="24" 
                       Foreground="#4CAF50"
                       VerticalAlignment="Center"
                       Margin="0,0,15,0"/>
            
            <!-- Message -->
            <TextBlock x:Name="MessageTextBlock" Grid.Column="1"
                       Text="Notification message" 
                       Foreground="White"
                       TextWrapping="Wrap"
                       FontSize="14"
                       VerticalAlignment="Center"/>
            
            <!-- Close button -->
            <Button Grid.Column="2" Content="✕" 
                    Background="Transparent"
                    Foreground="#999999"
                    BorderThickness="0"
                    Click="CloseButton_Click"
                    Padding="5"
                    Margin="10,0,0,0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</Window> 